# HubSpot Private App token
# Scopes required: crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.notes.write (or the equivalent engagements scope), sales-email-read
HUBSPOT_TOKEN=

# Z.ai API key — used only for the GLM backend (comparison suggestions when drafting)
ZAI_API_KEY=

# Claude Code CLI binary name or absolute path. Must already be logged in
# (`claude auth login`) so headless calls use your subscription.
CLAUDE_CLI_PATH=claude
